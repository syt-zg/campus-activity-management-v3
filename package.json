{
  "name": "campus-activity-management-system",
  "version": "3.1.0",
  "description": "校园活动管理系统（Node.js 全栈 + Electron 桌面版）",
  "author": "校园活动管理系统项目组",
  "main": "electron/main.js",
  "scripts": {
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.campus.activity.management",
    "productName": "校园活动管理系统",
    "asar": true,
    "directories": {
      "output": "release-single",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "校园活动管理系统-便携版-3.1.0.${ext}"
    }
  }
}
