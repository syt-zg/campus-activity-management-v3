{
  "name": "campus-activity-management-system",
  "version": "3.0.0",
  "description": "校园活动管理系统（Node.js 全栈 + Electron 桌面版）",
  "author": "校园活动管理系统项目组",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/app.js",
    "dev:electron": "electron .",
    "test": "node tests/v3-smoke.js",
    "test:ui": "node tests/ui-render.js",
    "test:perf": "node tests/perf-compare.js",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.campus.activity.management",
    "productName": "校园活动管理系统",
    "asar": true,
    "directories": {
      "output": "release-single",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "校园活动管理系统-便携版-3.0.0.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "校园活动管理系统-安装版-3.0.0.${ext}"
    }
  }
}
